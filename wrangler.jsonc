{
  // 쥴리 잉글리쉬 홈페이지 — Cloudflare Workers 설정
  // 정적 파일(public/)은 ASSETS 바인딩이 직접 서빙하고,
  // /api/* 로 들어오는 요청만 src/index.js 의 Worker 코드가 처리한다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "julie-enlgish",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // SPA 구조라 /timetable 같은 주소로 직접 들어와도 index.html 을 돌려준다.
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "julie-english",
      "database_id": "9fe40574-9532-4a9d-92b2-c7baecfefd8b",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      // 학원 안내의 사진·동영상 원본이 들어가는 곳
      "binding": "MEDIA",
      "bucket_name": "julie-english-media"
    }
  ],

  "vars": {
    "SITE_NAME": "쥴리 잉글리쉬"
  }
}
