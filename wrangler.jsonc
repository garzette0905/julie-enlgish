{
  // 쥴리 잉글리쉬 홈페이지 — Cloudflare Workers 설정
  // 정적 파일(public/)은 ASSETS 바인딩이 직접 서빙하고,
  // /api/* 로 들어오는 요청만 src/index.js 의 Worker 코드가 처리한다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "julie-enlgish",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // 홈페이지 주소. custom_domain 으로 두면 배포할 때 Cloudflare 가
  // DNS 레코드와 SSL 인증서까지 알아서 만들어 준다.
  // www 와 www 없는 주소 둘 다 같은 화면이 뜬다.
  // (julie-enlgish.wepiclab.workers.dev 주소도 그대로 살아 있다)
  "routes": [
    { "pattern": "www.julieenglish.co.kr", "custom_domain": true },
    { "pattern": "julieenglish.co.kr", "custom_domain": true }
  ],

  // routes 를 지정하면 wrangler 가 workers.dev 주소를 자동으로 꺼 버린다.
  // 예전에 공유한 julie-enlgish.wepiclab.workers.dev 링크가 갑자기 죽지 않도록
  // 명시적으로 켜 둔다.
  "workers_dev": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // SPA 구조라 /timetable 같은 주소로 직접 들어와도 index.html 을 돌려준다.
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "julie-english",
      "database_id": "9fe40574-9532-4a9d-92b2-c7baecfefd8b",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      // 학원 안내의 사진·동영상 원본이 들어가는 곳
      "binding": "MEDIA",
      "bucket_name": "julie-english-media"
    }
  ],

  "vars": {
    "SITE_NAME": "쥴리 잉글리쉬"
  }
}
